APP_NAME=FlightPulse Live API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATA_DIRECTORY=data
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/flightpulse
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OPENSKY_REQUEST_TIMEOUT=10

# Optional email delivery (STARTTLS; run the alert_delivery worker)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
